+    T* p{}; size_t n;
+    explicit Buffer(size_t size) : n(size) { check(cudaMalloc((void**)&p, n * sizeof(T))); }
+    ~Buffer() { cudaFree(p); }
+    void put(const std::vector<T>& v) { check(cudaMemcpy(p, v.data(), n * sizeof(T), cudaMemcpyHostToDevice)); }
