+void Gemm::native_static(const uint16_t* X, int ggml_type, const void* W_blocks, float* Y, int64_t T,
+                         int64_t N, int64_t K, int64_t ldy, float beta) {
+    auto* s = static_cast<WidenScratch*>(hipblaslt_state_);
+    if (s == nullptr || T < 64 || N <= 0 || K <= 0) {
+        native(X, ggml_type, W_blocks, Y, T, N, K, ldy, beta);
+        return;
+    }
+    if (!s->dense_initialized) {
+        s->dense_initialized = true;
+        const char* e = std::getenv("STRATA_METAL_PREFILL_DENSE_CACHE_MB");
+        size_t free_bytes = 0, total_bytes = 0;
+        // Opt-in, capped by the device working set and headroom after model/context allocation.
+        if (e && e[0] != '-' && cudaMemGetInfo(&free_bytes, &total_bytes) == cudaSuccess) {
+            const auto mb = std::min<unsigned long long>(std::strtoull(e, nullptr, 10), 4096);
+            s->dense_limit = std::min({size_t(mb) * (size_t(1) << 20), total_bytes / 16, free_bytes / 4});
+            std::fprintf(stderr, "Metal prefill dense cache: limit %zu MiB, free %zu MiB\n",
+                         s->dense_limit >> 20, free_bytes >> 20);
+        }
+    }
+    if (s->dense_limit == 0) {
+        native(X, ggml_type, W_blocks, Y, T, N, K, ldy, beta);
+        return;
+    }
+    const WidenScratch::DenseKey key{(uintptr_t)W_blocks, ggml_type, N, K};
+    const auto found = s->dense.find(key);
+    if (found != s->dense.end()) {
+        f16(X, found->second, Y, T, N, K, ldy, beta);
+        return;
+    }
+    if (s->dense_limit > s->dense_bytes && uint64_t(N) <= std::numeric_limits<size_t>::max() / 2 / uint64_t(K)) {
+        const size_t bytes = size_t(N) * size_t(K) * 2;
+        size_t free_bytes = 0, total_bytes = 0;
+        uint16_t* image = nullptr;
+        if (bytes <= s->dense_limit - s->dense_bytes &&
+            cudaMemGetInfo(&free_bytes, &total_bytes) == cudaSuccess && bytes <= free_bytes / 4) {
+            if (cudaMalloc(&image, bytes) != cudaSuccess) {
+                (void)cudaGetLastError();
+                native(X, ggml_type, W_blocks, Y, T, N, K, ldy, beta);
+                return;
+            }
+            // Same dequantizer, half rounding and serial stream as native(); no alternate precision.
+            strata::kernels::dequant_f16(ggml_type, W_blocks, 0, N, K, image, stream_);
+            s->dense.emplace(key, image);
+            s->dense_bytes += bytes;
+            f16(X, image, Y, T, N, K, ldy, beta);
+            return;
+        }
+    }
+    native(X, ggml_type, W_blocks, Y, T, N, K, ldy, beta);
+}
+
 }  // namespace strata::prefill
