+// Cached immutable dense weights must match ordinary dequantization on first use, reuse,
+// strided beta accumulation and when the bounded cache cannot admit a larger matrix.
+int cached_dense_case(cudaStream_t stream, std::mt19937& rng) {
+    namespace k = strata::kernels;
+    setenv("STRATA_METAL_PREFILL_DENSE_CACHE_MB", "1", 1);
+    constexpr int K = 512, T = 65;
+    int failures = 0;
+    for (int type : {8, 23}) {
+        uint8_t* blocks = nullptr;
+        uint16_t* x = nullptr;
+        float *expected = nullptr, *actual = nullptr;
+        constexpr int max_n = 2048, max_ld = max_n + 7;
+        std::vector<uint8_t> source(max_n * k::iq_row_bytes(type, K));
+        for (auto& v : source) v = (uint8_t) rng();
+        const auto block_bytes = k::iq_row_bytes(type, type == 8 ? 32 : 256);
+        for (size_t i = 0; i < source.size(); i += block_bytes) {
+            const uint16_t d = k::f16_from_f32(float(int(rng() % 63) - 31) / 8192);
+            std::memcpy(source.data() + i, &d, 2);
+        }
+        cudaMalloc(&blocks, source.size());
+        cudaMalloc(&x, T * K * 2);
+        cudaMalloc(&expected, T * max_ld * 4);
+        cudaMalloc(&actual, T * max_ld * 4);
+        cudaMemcpyAsync(blocks, source.data(), source.size(), cudaMemcpyHostToDevice, stream);
+        {
+            strata::prefill::Gemm gm;
+            std::string err;
+            if (!gm.init(stream, 64 * K, err)) return 1;
+            for (int N : {37, 37, max_n, 37}) for (float beta : {0.0f, 1.0f}) {
+                const int ld = N + 7;
+                std::vector<uint16_t> input(T * K);
+                for (auto& v : input) v = k::f16_from_f32(float(int(rng() % 2001) - 1000) / 113);
+                std::vector<float> got(T * ld, -987.f), want(got);
+                cudaMemcpyAsync(x, input.data(), input.size() * 2, cudaMemcpyHostToDevice, stream);
+                cudaMemcpyAsync(expected, want.data(), want.size() * 4, cudaMemcpyHostToDevice, stream);
+                cudaMemcpyAsync(actual, got.data(), got.size() * 4, cudaMemcpyHostToDevice, stream);
+                gm.native(x, type, blocks, expected, T, N, K, ld, beta);
+                gm.native_static(x, type, blocks, actual, T, N, K, ld, beta);
+                cudaStreamSynchronize(stream);
+                cudaMemcpy(got.data(), actual, got.size() * 4, cudaMemcpyDeviceToHost);
+                cudaMemcpy(want.data(), expected, want.size() * 4, cudaMemcpyDeviceToHost);
+                const bool equal = std::memcmp(got.data(), want.data(), want.size() * 4) == 0;
+                failures += !equal;
+                for (float v : got) failures += !std::isfinite(v);
+            }
+        }
+        cudaFree(blocks); cudaFree(x); cudaFree(expected); cudaFree(actual);
+    }
+    unsetenv("STRATA_METAL_PREFILL_DENSE_CACHE_MB");
+    std::printf("Bounded immutable dense cache: %d failures\n", failures);
+    return failures;
+}
