+// Resident IQ4_NL down: reuse each activation across four rows and form the
+// integer codebook dot directly. The 16 products sum to < 2^24, so FMA is exact;
+// scale multiplication, ascending per-lane accumulation and XOR are unchanged.
+// M2 Max, ABBA >=10 s per point (2026-10-11-metal-mtp-kernel-optimization):
+// 2560 x 640, ten entries ~125 -> 84 us; forty entries ~502 -> 347 us.
+template<int R>
+static inline void iqk_resident_down_direct_iq4_nl(constant const uint8_t* arena, constant const ulong* offsets,
+    constant const int* ids, constant const int* residency, constant const block_q8_1* xq,
+    long n_embd, long n_ff, ulong row_bytes, ulong weight_offset, ulong slot_bytes, int n_expert,
+    int has_offsets, device float* out, threadgroup const float* table, uint3 gp, uint tid) {
+    const int e = (int) gp.y, lane = (int) (tid & 31);
+    const int row0 = ((int) gp.x * 8 + (int) (tid >> 5)) * R;
