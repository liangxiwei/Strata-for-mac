# Generated, not source: deterministic build products of tools/ (see docs/).
# tiny-qwen4exp.gguf is ~113 MB, over GitHub's 100 MB file limit -- regenerate with
#   python tools/make_tiny_model.py
bench/tiny-*.gguf
bench/wide-*.gguf
bench/micro/*.exe
bench/micro/*.obj
bench/micro/*.bin
bench/micro/*.dll
bench/micro/*.txt
*.log
build*/
pack/
logs/
__pycache__/
.pytest_cache/
*.pyc

# plan v0.3 P1 (repository hygiene, review E1): profiler captures and large diagnostic dumps stay out of git.
*.nsys-rep

# Pi harness metadata (local session state, not project source)
*.sqlite
*.npz
*.occ1
td.log

# created by setup.py on the user's machine
/.venv/
/build/
# the model files on a Mac (models/, packs/, mtp/, ~70 GB): inside the folder, named by relative paths in its config
/Strata-data/
/third_party/llama.cpp
/models/
/packs/
/mtp/
/run-*.bat
/run-*.sh
/strata-*.json
/strata-*.log
/build-strata.bat
/.strata-mcp/

# image encoder (setup.py --vision): build output and the generated build script
build-vision*/
build-vision.bat

# setup.py outputs (engine, downloads) and release builds
/engine/
/build-release*/
/dist/
*.done
/third_party/*.zip

/.rocm-win/

# Metal port evidence (bench/results/2026-10-03-metal*): the logs at each directory's top level (build, ctest, audit)
# are the evidence the READMEs cite and stay tracked; the audits' full-vocabulary logit traces (~370 MB per audit)
# are regenerated by audit_model.py and stay out
!bench/results/2026-10-03-metal*/**/*.log
bench/results/**/logits-*.bin
bench/results/**/__pycache__/
# 2026-10-04 (Mac: pictures, Q2_0, 128K): each run's raw output (run/) stays on the measuring machine
bench/results/2026-10-04-metal*/run/
# ... and each run's raw output directory (engine.log, results.json, config.json) stays on the measuring machine
# (they were committed once, in f90370f: `git show f90370f:<path>` gets one back):
# the round READMEs, summaries, audit comparisons, drivers and microbenchmarks are tracked, plus the frozen inputs
# the drivers read (the 10K / 100K prompts, the reference ids, the server config)
bench/results/2026-10-03-metal*/*/
!bench/results/2026-10-03-metal-decode-opt2/micro/
!bench/results/2026-10-03-metal-prefill-opt/micro/
!bench/results/2026-10-03-metal-iq2-xs-opt/tiled/
!bench/results/2026-10-03-metal-decode-opt/baseline/
bench/results/2026-10-03-metal-decode-opt/baseline/*
!bench/results/2026-10-03-metal-decode-opt/baseline/results.json
!bench/results/2026-10-03-metal-10k-mtp/mtp-off/
bench/results/2026-10-03-metal-10k-mtp/mtp-off/*
!bench/results/2026-10-03-metal-10k-mtp/mtp-off/prompt-tokens.txt
!bench/results/2026-10-03-metal-10k-mtp/mtp-on/
bench/results/2026-10-03-metal-10k-mtp/mtp-on/*
!bench/results/2026-10-03-metal-10k-mtp/mtp-on/request.json
!bench/results/2026-10-03-metal-10k-mtp/mtp-on/server-config.json
# per-machine scratch of local tooling
.claude/
